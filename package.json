{
  "name": "@pointcloudtechnology/resumablejs",
  "version": "5.0.0",
  "description": "A JavaScript library for providing multiple simultaneous, stable, fault-tolerant and resumable/restartable uploads using Livewire v3 native upload functionality.",
  "main": "dist/resumable-livewire.umd.js",
  "module": "dist/resumable-livewire.es.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/resumable-livewire.es.js",
      "require": "./dist/resumable-livewire.umd.js"
    }
  },
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "files": [
    "dist",
    "js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errahmouniabdelhamid/resumable.js.git"
  },
  "keywords": [
    "html5",
    "file",
    "upload",
    "livewire",
    "laravel",
    "resumable",
    "chunks"
  ],
  "author": "https://github.com/errahmouniabdelhamid/resumable.js/graphs/contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/errahmouniabdelhamid/resumable.js/issues"
  },
  "homepage": "https://github.com/errahmouniabdelhamid/resumable.js#readme",
  "devDependencies": {
    "terser": "^5.44.0",
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
